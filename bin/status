#!/usr/bin/env python3
"""Summarize Git state for every workspace attachment."""

from __future__ import annotations

from collections import OrderedDict
from pathlib import Path
import subprocess
import sys

try:
    import tomllib
except ModuleNotFoundError:
    sys.exit("bin/status requires Python 3.11 or newer (tomllib is unavailable)")


ROOT = Path(__file__).resolve().parent.parent
MANIFEST = ROOT / "workspace.toml"


def git(path: Path, *args: str) -> tuple[bool, str]:
    result = subprocess.run(
        ("git", "-C", str(path), *args),
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )
    return result.returncode == 0, result.stdout.strip()


def repository_state(path: Path) -> list[str]:
    valid, _ = git(path, "rev-parse", "--git-dir")
    if not path.exists():
        return ["missing"]
    if not valid:
        return ["not a Git repository"]

    on_branch, branch = git(path, "symbolic-ref", "--quiet", "--short", "HEAD")
    if on_branch:
        lines = [branch]
    else:
        has_head, commit = git(path, "rev-parse", "--short", "HEAD")
        lines = [f"detached at {commit}" if has_head else "HEAD unavailable"]

    _, porcelain = git(path, "status", "--porcelain")
    dirty = len(porcelain.splitlines()) if porcelain else 0
    lines.append(f"dirty: {dirty} file{'s' if dirty != 1 else ''}" if dirty else "clean")

    has_upstream, upstream = git(path, "rev-parse", "--abbrev-ref", "@{upstream}")
    if has_upstream:
        counted, counts = git(path, "rev-list", "--left-right", "--count", "HEAD...@{upstream}")
        if counted:
            ahead, behind = counts.split()
            lines.append(f"ahead: {ahead}, behind: {behind} ({upstream})")
    return lines


def main() -> int:
    try:
        with MANIFEST.open("rb") as handle:
            data = tomllib.load(handle)
        attachments = data["attachments"]
    except (OSError, KeyError, TypeError, tomllib.TOMLDecodeError) as error:
        print(f"manifest error: {error}", file=sys.stderr)
        return 2

    grouped: OrderedDict[str, list[dict]] = OrderedDict()
    for attachment in attachments:
        grouped.setdefault(attachment["group"], []).append(attachment)

    print("midstream workspace")
    for group, entries in grouped.items():
        print(f"\n{group}")
        for attachment in entries:
            path = ROOT / attachment["path"]
            print(f"  {path.name} — {attachment['name']}")
            for line in repository_state(path):
                print(f"    {line}")
            print(f"    {attachment['path']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
